import pandas as pd
import numpy as np
import torch
from torch import nn
from torch.utils.data import Dataset, DataLoader
from transformers import AutoTokenizer, AutoModel, get_linear_schedule_with_warmup #sherwin -  adding imprt for learning rate scheduler
from sklearn.metrics import accuracy_score, classification_report
from sklearn.model_selection import train_test_split
from sklearn.utils.class_weight import compute_class_weight
from tqdm import tqdm


def load_data(filepath: str) -> pd.DataFrame:
    columns = [
        'id', 'label', 'statement', 'subject', 'speaker', 'job_title',
        'state', 'party', 'barely_true_ct', 'false_ct', 'half_true_ct', 
        'mostly_true_ct', 'pants_fire_ct', 'context'
    ]
    df = pd.read_csv(filepath, sep='\t', header=None, names=columns)
    count_cols = ['barely_true_ct', 'false_ct', 'half_true_ct', 'mostly_true_ct', 'pants_fire_ct']
    df[count_cols] = ( #sherwin addition making sure counts are numeric
        df[count_cols]
        .apply(pd.to_numeric, errors='coerce')
        .fillna(0)
        .astype(int)
    )
    
    text_cols = ['statement', 'subject', 'speaker', 'job_title', 'state', 'party', 'context']
    df[text_cols] = df[text_cols].fillna('')
    return df

#Using DistilBERT for classifying missinfo, better than log regression. BC logistic regression loses a lot of context & semantics, harder to determine missinfo Used in HW2
#Loads data, trains it, and then evaluates it. Built off of Tia and Kartik's code
#used model learned from HW2 to handle multi class classification and creates a label mapping for it. Then saves the best model

def create_enhanced_input(row): #sherwin - new function
    statement = str(row['statement']) #sherwin - enchancing input with more context and combining fields
    subject = str(row['subject'])
    speaker = str(row['speaker'])
    context = str(row['context'])
    party = str(row['party'])
    
    history_counts = []
    if row['barely_true_ct'] > 0:
        history_counts.append(f"barely-true:{row['barely_true_ct']}")
    if row['false_ct'] > 0:
        history_counts.append(f"false:{row['false_ct']}")
    if row['mostly_true_ct'] > 0:
        history_counts.append(f"mostly-true:{row['mostly_true_ct']}")
    if row['pants_fire_ct'] > 0:
        history_counts.append(f"pants-fire:{row['pants_fire_ct']}")
    
    history = " ".join(history_counts) if history_counts else "no-history"
    
    enhanced_text = ( #combining features with [SEP] tokens
        f"{statement} [SEP] Subject: {subject} [SEP] Speaker: {speaker} {party} "
        f"[SEP] History: {history} [SEP] Context: {context}"
    )
    return enhanced_text


class MisinformationDataset(Dataset):
    def __init__(self, data, tokenizer, max_len=256): #changed max_len to 256
        self.data = data
        self.tokenizer = tokenizer
        self.max_len = max_len
        self.len = len(data['input'])
        self.prepare()
    
    def prepare(self):
        #Tokenization
        self.input_ids = []
        self.attention_masks = []
        
        for text in self.data['input']:
            encoded = self.tokenizer.encode_plus(
                text,
                add_special_tokens=True,
                max_length=self.max_len,
                padding='max_length',
                truncation=True,
                return_attention_mask=True,
                return_tensors='pt'
            )
            
            self.input_ids.append(encoded['input_ids'].squeeze())
            self.attention_masks.append(encoded['attention_mask'].squeeze())
    
    def __len__(self):
        return self.len
    
    def __getitem__(self, idx):
        return {
            'input_ids': self.input_ids[idx],
            'attention_mask': self.attention_masks[idx],
            'label': torch.tensor(self.data['label'][idx], dtype=torch.long)
        }


class ClassificationModel(nn.Module): #sherwin - made modifications to the model
    """DistilBERT classification model - from HW2"""
    def __init__(self, base_model, num_classes, dropout_rate=0.2): #sherwin - added dropout rate
        super().__init__()
        self.base_model = base_model
        self.dropout1 = nn.Dropout(dropout_rate) #sherwin - added more dropout and 3 layers
        self.fc1 = nn.Linear(768, 512)
        self.bn1 = nn.BatchNorm1d(512)
        self.relu = nn.ReLU()
        self.dropout2 = nn.Dropout(dropout_rate)
        self.fc2 = nn.Linear(512, 256)
        self.bn2 = nn.BatchNorm1d(256)
        self.dropout3 = nn.Dropout(dropout_rate)
        self.fc3 = nn.Linear(256, num_classes)
    
    def forward(self, input_ids, attention_mask):
        outputs = self.base_model(input_ids=input_ids, attention_mask=attention_mask)
        pooled_output = outputs.last_hidden_state[:, 0, :]
        x = self.dropout1(pooled_output) #sherwin - added 3 layer NN with batchnorm and relu
        x = self.fc1(x)
        x = self.bn1(x)
        x = self.relu(x)
        x = self.dropout2(x)
        x = self.fc2(x)
        x = self.bn2(x)
        x = self.relu(x)
        x = self.dropout3(x)
        logits = self.fc3(x) #returning logits not softmax probs
        return logits


def prepare_label_mapping(train_df):
    unique_labels = sorted(train_df['label'].unique())
    label_to_id = {label: idx for idx, label in enumerate(unique_labels)}
    id_to_label = {idx: label for label, idx in label_to_id.items()}
    print(f"\nLabel mapping:")
    for label, idx in label_to_id.items():
        print(f"  {label} -> {idx}")
    return label_to_id, id_to_label


def train_model(train_df, valid_df, epochs=12, batch_size=32, learning_rate=3e-5,weight_decay=0.01, warmup_ratio=0.1, patience=4): #changed and added parameters
    device = torch.device("cuda:0" if torch.cuda.is_available() else "cpu")
    print(f"device: {device}")
    label_to_id, id_to_label = prepare_label_mapping(train_df)
    num_classes = len(label_to_id)
    train_labels = [label_to_id[label] for label in train_df['label']]
    valid_labels = [label_to_id[label] for label in valid_df['label']]
    print("\nCalculating class weights...") #sherwin - added class weights to handle class imbalance
    class_weights = compute_class_weight('balanced', classes=np.unique(train_labels), y=train_labels)
    class_weights = torch.FloatTensor(class_weights).to(device)
    print("\nLoad DistilBERT:")
    tokenizer = AutoTokenizer.from_pretrained('distilbert/distilbert-base-uncased')
    bertmodel = AutoModel.from_pretrained('distilbert/distilbert-base-uncased')
    #Creating datasets
    print("Prep datasets:")
    train_inputs = [create_enhanced_input(row) for _, row in train_df.iterrows()] #sherwin - using enchanced input function with features
    valid_inputs = [create_enhanced_input(row) for _, row in valid_df.iterrows()]
    train_data = {'input': train_inputs, 'label': train_labels}
    valid_data = {'input': valid_inputs, 'label': valid_labels}
    train_dataset = MisinformationDataset(train_data, tokenizer)
    valid_dataset = MisinformationDataset(valid_data, tokenizer)
    
    #dataloaders
    train_dataloader = DataLoader(train_dataset, batch_size=batch_size, shuffle=True)
    valid_dataloader = DataLoader(valid_dataset, batch_size=batch_size, shuffle=False)
    model = ClassificationModel(base_model=bertmodel, num_classes=num_classes)
    model = model.to(device)
    optimizer = torch.optim.AdamW(model.parameters(), lr=learning_rate, weight_decay=weight_decay) #sherwin - added decay parameter
    criterion = nn.CrossEntropyLoss(weight=class_weights, label_smoothing=0.1) #sherwin - handling class imbalance with parametes
    total_steps = epochs * len(train_dataloader) #sherwin - warmup step process with linear decay helps with convergence
    warmup_steps = int(total_steps * warmup_ratio)
    scheduler = get_linear_schedule_with_warmup(
        optimizer,
        num_warmup_steps=warmup_steps,
        num_training_steps=total_steps
    )
    best_model = None
    best_val_acc = 0  #sherwin - made to switch to track accuracy
    patience_count = 0
    print(f"\nStarting training for {epochs} epochs:")
    for epoch in range(epochs):
        model.train()
        train_loss = 0
        train_correct = 0
        train_total = 0 
        pbar = tqdm(train_dataloader, desc=f"Epoch {epoch+1}/{epochs} [Train]") #sherwin - added a progress bar to highlight training
        for batch in pbar:
            input_ids = batch['input_ids'].to(device)
            attention_mask = batch['attention_mask'].to(device)
            labels = batch['label'].to(device)
            optimizer.zero_grad()
            logits = model(input_ids, attention_mask) #sherwin - renaming to logits here
            loss = criterion(logits, labels)
            loss.backward()
            torch.nn.utils.clip_grad_norm_(model.parameters(), 1.0) #sherwin - I clip gradients to avoid the exploding gradient problem         
            optimizer.step()
            scheduler.step() #sherwin - stepping scheduler after each batch
            train_loss += loss.item()
            _, predicted = torch.max(logits, 1)
            train_total += labels.size(0)
            train_correct += (predicted == labels).sum().item()
            pbar.set_postfix({'loss': loss.item(), 'acc': 100 * train_correct / train_total}) #sherwin - here I update the progress bar
        
        avg_train_loss = train_loss / len(train_dataloader)
        train_acc = train_correct / train_total 
        #validation 
        model.eval()
        valid_loss = 0
        valid_correct = 0
        valid_total = 0
        with torch.no_grad():
            for batch in tqdm(valid_dataloader, desc=f"Epoch {epoch+1}/{epochs} [Valid]"): #sherwin - another progress bar for validation
                input_ids = batch['input_ids'].to(device)
                attention_mask = batch['attention_mask'].to(device)
                labels = batch['label'].to(device)
                logits = model(input_ids, attention_mask)
                loss = criterion(logits, labels)
                valid_loss += loss.item()
                _, predicted = torch.max(logits, 1)
                valid_total += labels.size(0)
                valid_correct += (predicted == labels).sum().item()
        
        avg_valid_loss = valid_loss / len(valid_dataloader)
        valid_acc = valid_correct / valid_total
        print(f'\nEpoch {epoch + 1} Summary:') #sherwin - updated the epoch summary
        print(f'  Train Loss: {avg_train_loss:.4f}, Train Acc: {train_acc:.2%}')
        print(f'  Valid Loss: {avg_valid_loss:.4f}, Valid Acc: {valid_acc:.2%}')
        
        if valid_acc > best_val_acc: #sherwin - here I account for early stopping with the patience variable -> purpose of stopping early is to avoid overfitting
            best_val_acc = valid_acc
            best_model = model.state_dict().copy()
            patience_count = 0
            print(f'New best model saved! (Valid Acc: {best_val_acc:.2%})')
        else:
            patience_count += 1
            print(f'No improvement ({patience_count}/{patience})')
        
        if patience_count >= patience:
            print("\n Early stopping triggered!") #sherwin - checking early stopping and actually stopping if necessary
            break
    
    model.load_state_dict(best_model)
    
    return model, tokenizer, label_to_id, id_to_label


def evaluate(model, tokenizer, test_df, label_to_id, id_to_label, batch_size=32):  #sherwin - changed batch size
    device = torch.device("cuda:0" if torch.cuda.is_available() else "cpu")
    model = model.to(device)
    model.eval()
    test_labels = [label_to_id[label] for label in test_df['label']]
    #creating dataset
    test_inputs = [create_enhanced_input(row) for _, row in test_df.iterrows()] #sherwin - I used the enchanced feature here too
    test_data = {'input': test_inputs, 'label': test_labels}
    test_dataset = MisinformationDataset(test_data, tokenizer)
    test_dataloader = DataLoader(test_dataset, batch_size=batch_size, shuffle=False)
    all_predictions = []
    all_labels = []
    with torch.no_grad():
        for batch in tqdm(test_dataloader, desc="Testing"): #sherwin - I gave testing a progress bar too
            input_ids = batch['input_ids'].to(device)
            attention_mask = batch['attention_mask'].to(device)
            labels = batch['label'].to(device)
            
            logits = model(input_ids, attention_mask)
            _, predicted = torch.max(logits, 1)
            
            all_predictions.extend(predicted.cpu().numpy())
            all_labels.extend(labels.cpu().numpy())
    pred_labels = [id_to_label[pred] for pred in all_predictions]
    true_labels = [id_to_label[label] for label in all_labels]
    test_df = test_df.copy()
    test_df['predicted'] = pred_labels
    test_df['correct'] = test_df['predicted'] == test_df['label']
    print(f"\nTest accuracy: {accuracy_score(true_labels, pred_labels):.1%}")
    print(f"\nClassification Report:\n{classification_report(true_labels, pred_labels)}")
    
    return test_df


if __name__ == "__main__":
    print("Loading datasets:")
